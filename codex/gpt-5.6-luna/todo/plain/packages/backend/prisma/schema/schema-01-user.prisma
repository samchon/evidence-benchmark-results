/// Credentialed private account.
model user_accounts {
  /// Primary identifier.
  id String @id
  /// Canonical lower-case, trimmed email identity.
  email String @unique
  /// Password hash produced by the backend.
  password_hash String
  /// Credential replacement generation; incrementing it invalidates old tokens.
  credential_version Int
  /// Account creation instant.
  created_at DateTime
  /// Private profile owned by this account.
  profile user_profiles?
  /// Sessions issued for this account.
  sessions user_sessions[]
  /// Todos owned by this account.
  todos user_todos[]
}

/// One-to-one private display profile.
model user_profiles {
  /// Primary identifier.
  id String @id
  /// Owning account identifier.
  user_account_id String @unique
  /// Current trimmed display name.
  display_name String
  /// Profile creation instant.
  created_at DateTime
  /// Owning account.
  account user_accounts @relation(fields: [user_account_id], references: [id], onDelete: Cascade)
}

/// One authenticated connection for an account.
model user_sessions {
  /// Primary identifier.
  id String @id
  /// Owning account identifier.
  user_account_id String
  /// Credential generation accepted when this session was issued.
  credential_version Int
  /// Session creation instant.
  created_at DateTime
  /// Owning account.
  account user_accounts @relation(fields: [user_account_id], references: [id], onDelete: Cascade)
  /// Index supporting account session invalidation.
  @@index([user_account_id])
}

/// Private todo owned permanently by one account.
model user_todos {
  /// Primary identifier.
  id String @id
  /// Owning account identifier.
  user_account_id String
  /// Required task title.
  title String
  /// Optional task description. Null means no description.
  description String?
  /// Optional intended start calendar date. Null means unset.
  start_date DateTime?
  /// Optional intended due calendar date. Null means unset.
  due_date DateTime?
  /// Completion state: incomplete or complete.
  completed Boolean
  /// Availability state: active or trashed.
  trashed Boolean
  /// Most recent move into trash. Null while active.
  trashed_at DateTime?
  /// Original creation instant.
  created_at DateTime
  /// Latest accepted content-edit instant, or creation instant before edits.
  updated_at DateTime
  /// Owning account.
  account user_accounts @relation(fields: [user_account_id], references: [id], onDelete: Cascade)
  /// Immutable content-edit history.
  histories user_todo_histories[]
  @@index([user_account_id, trashed])
  @@index([user_account_id, trashed_at])
  @@index([created_at])
}

/// Immutable snapshot of one accepted todo content edit.
model user_todo_histories {
  /// Primary identifier.
  id String @id
  /// Todo whose content was edited.
  user_todo_id String
  /// Edit instant.
  edited_at DateTime
  /// New title when title participated in the edit; null otherwise.
  title String?
  /// New description when description participated; null otherwise.
  description String?
  /// New start date when start date participated; null otherwise.
  start_date DateTime?
  /// New due date when due date participated; null otherwise.
  due_date DateTime?
  /// Whether the description field participated, preserving an explicit clear.
  description_changed Boolean
  /// Whether the start date field participated, preserving an explicit clear.
  start_date_changed Boolean
  /// Whether the due date field participated, preserving an explicit clear.
  due_date_changed Boolean
  /// Todo owner relation.
  todo user_todos @relation(fields: [user_todo_id], references: [id], onDelete: Cascade)
  @@index([user_todo_id, edited_at])
}

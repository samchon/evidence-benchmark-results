  "components": {
    "schemas": {
      "IActionResult": {
        "additionalProperties": false,
        "description": "A successful command acknowledgement.",
        "properties": {
          "success": {
            "const": true,
            "description": null,
            "title": null
          }
        },
        "required": [
          "success"
        ],
        "type": "object"
      },
      "IAuth.IDeleteAccount": {
        "additionalProperties": false,
        "description": "Password confirmation for terminal account deletion.",
        "properties": {
          "currentPassword": {
            "description": "Current password proving authority.",
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "currentPassword"
        ],
        "type": "object"
      },
      "IAuth.IAuthorized": {
        "additionalProperties": false,
        "description": "Issued session material.",
        "properties": {
          "token": {
            "additionalProperties": false,
            "description": "Tokens retained by the client connection.",
            "properties": {
              "access": {
                "type": "string"
              },
              "refresh": {
                "type": "string"
              }
            },
            "required": [
              "access",
              "refresh"
            ],
            "type": "object"
          },
          "accessTokenExpiresAt": {
            "description": "Access-token expiry instant.",
            "format": "date-time",
            "type": "string"
          },
          "refreshTokenExpiresAt": {
            "description": "Refresh-token expiry instant.",
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "token",
          "accessTokenExpiresAt",
          "refreshTokenExpiresAt"
        ],
        "type": "object"
      },
      "IAuth.IJoin": {
        "additionalProperties": false,
        "description": "Creates an account, profile, empty Todo collection, and first session.",
        "properties": {
          "email": {
            "description": "Canonicalized email identity.",
            "format": "email",
            "type": "string"
          },
          "password": {
            "description": "Plaintext password accepted only at the transport boundary.",
            "maxLength": 128,
            "minLength": 8,
            "type": "string"
          },
          "displayName": {
            "description": "Initial private display name.",
            "maxLength": 100,
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "email",
          "password",
          "displayName"
        ],
        "type": "object"
      },
      "IAuth.ILogin": {
        "additionalProperties": false,
        "description": "Login input.",
        "properties": {
          "email": {
            "description": "Email identity.",
            "format": "email",
            "type": "string"
          },
          "password": {
            "description": "Plaintext password.",
            "maxLength": 128,
            "minLength": 8,
            "type": "string"
          }
        },
        "required": [
          "email",
          "password"
        ],
        "type": "object"
      },
      "IAuth.IChangePassword": {
        "additionalProperties": false,
        "description": "Password replacement input.",
        "properties": {
          "currentPassword": {
            "description": "Current password proving authority.",
            "minLength": 1,
            "type": "string"
          },
          "newPassword": {
            "description": "New password.",
            "maxLength": 128,
            "minLength": 8,
            "type": "string"
          }
        },
        "required": [
          "currentPassword",
          "newPassword"
        ],
        "type": "object"
      },
      "IAuth.IRecover": {
        "additionalProperties": false,
        "description": "Email-proven forgotten-password replacement input.",
        "properties": {
          "email": {
            "description": "Registered email identity.",
            "format": "email",
            "type": "string"
          },
          "newPassword": {
            "description": "Replacement password.",
            "maxLength": 128,
            "minLength": 8,
            "type": "string"
          }
        },
        "required": [
          "email",
          "newPassword"
        ],
        "type": "object"
      },
      "IAuth.IRefresh": {
        "additionalProperties": false,
        "description": "Refresh input.",
        "properties": {
          "refreshToken": {
            "description": "Previously issued refresh proof.",
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "refreshToken"
        ],
        "type": "object"
      },
      "IProfile": {
        "additionalProperties": false,
        "description": "The authenticated account's private profile.",
        "properties": {
          "id": {
            "description": "Stable profile identifier.",
            "format": "uuid",
            "type": "string"
          },
          "displayName": {
            "description": "Current trimmed display name.",
            "maxLength": 100,
            "minLength": 1,
            "type": "string"
          },
          "createdAt": {
            "description": "Creation instant.",
            "format": "date-time",
            "type": "string"
          },
          "updatedAt": {
            "description": "Last update instant.",
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "id",
          "displayName",
          "createdAt",
          "updatedAt"
        ],
        "type": "object"
      },
      "IProfileUpdate": {
        "additionalProperties": false,
        "description": "Display-name replacement body.",
        "properties": {
          "displayName": {
            "description": "Trimmed display name.",
            "maxLength": 100,
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "displayName"
        ],
        "type": "object"
      },
      "ITodo": {
        "additionalProperties": false,
        "description": "Complete private Todo detail.",
        "properties": {
          "id": {
            "description": "Stable Todo identity.",
            "format": "uuid",
            "type": "string"
          },
          "title": {
            "description": "User-authored title.",
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          },
          "description": {
            "description": "Optional description.",
            "oneOf": [
              {
                "type": "null"
              },
              {
                "maxLength": 10000,
                "type": "string"
              }
            ]
          },
          "startDate": {
            "description": "Optional start instant.",
            "oneOf": [
              {
                "type": "null"
              },
              {
                "format": "date-time",
                "type": "string"
              }
            ]
          },
          "dueDate": {
            "description": "Optional due instant.",
            "oneOf": [
              {
                "type": "null"
              },
              {
                "format": "date-time",
                "type": "string"
              }
            ]
          },
          "completed": {
            "description": "Completion state.",
            "type": "boolean"
          },
          "createdAt": {
            "description": "Creation instant.",
            "format": "date-time",
            "type": "string"
          },
          "updatedAt": {
            "description": "Last accepted content or completion edit.",
            "format": "date-time",
            "type": "string"
          },
          "availability": {
            "description": "Active or trashed availability.",
            "oneOf": [
              {
                "const": "active",
                "description": null,
                "title": null
              },
              {
                "const": "trashed",
                "description": null,
                "title": null
              }
            ]
          },
          "trashedAt": {
            "description": "Soft-delete instant.",
            "oneOf": [
              {
                "type": "null"
              },
              {
                "format": "date-time",
                "type": "string"
              }
            ]
          }
        },
        "required": [
          "id",
          "title",
          "description",
          "startDate",
          "dueDate",
          "completed",
          "createdAt",
          "updatedAt",
          "availability",
          "trashedAt"
        ],
        "type": "object"
      },
      "ITodoCompletion": {
        "additionalProperties": false,
        "description": "Completion command body.\nCompletion state command body.",
        "properties": {
          "completed": {
            "description": "Requested completion state.",
            "type": "boolean"
          }
        },
        "required": [
          "completed"
        ],
        "type": "object"
      },
      "ITodoCreate": {
        "additionalProperties": false,
        "description": "Todo creation body.",
        "properties": {
          "title": {

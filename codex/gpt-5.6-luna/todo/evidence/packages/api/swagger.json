  "components": {
    "schemas": {
      "ITodoUser.IDelete": {
        "additionalProperties": false,
        "description": "Current password required for terminal account deletion.",
        "properties": {
          "password": {
            "description": "Existing password confirming the irreversible action.",
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "password"
        ],
        "type": "object"
      },
      "ITodoTodo": {
        "additionalProperties": false,
        "description": "A complete private Todo detail.",
        "properties": {
          "id": {
            "description": "Todo UUID, stable across edits, trash, and restoration.",
            "format": "uuid",
            "type": "string"
          },
          "title": {
            "description": "Current required normalized title.",
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          },
          "description": {
            "description": "Full optional description; null means it is empty.",
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "string"
              }
            ]
          },
          "startDate": {
            "description": "Optional calendar start date, represented without a time of day.",
            "oneOf": [
              {
                "type": "null"
              },
              {
                "format": "date",
                "type": "string"
              }
            ]
          },
          "dueDate": {
            "description": "Optional calendar due date, represented without a time of day.",
            "oneOf": [
              {
                "type": "null"
              },
              {
                "format": "date",
                "type": "string"
              }
            ]
          },
          "status": {
            "description": "Completion state preserved independently from availability.",
            "oneOf": [
              {
                "const": "complete",
                "description": null,
                "title": null
              },
              {
                "const": "incomplete",
                "description": null,
                "title": null
              }
            ]
          },
          "availability": {
            "description": "Availability state: active work or retained trash.",
            "oneOf": [
              {
                "const": "active",
                "description": null,
                "title": null
              },
              {
                "const": "trashed",
                "description": null,
                "title": null
              }
            ]
          },
          "createdAt": {
            "description": "Original creation instant, unchanged by later lifecycle actions.",
            "format": "date-time",
            "type": "string"
          },
          "trashedAt": {
            "description": "Most recent move into trash, or null while not currently retained there.",
            "oneOf": [
              {
                "type": "null"
              },

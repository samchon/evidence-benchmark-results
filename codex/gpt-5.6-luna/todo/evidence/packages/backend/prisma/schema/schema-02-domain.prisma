model todo_todos {
  /// Application-assigned UUID.
  id String @id

  /// Permanent owning account UUID.
  todo_user_id String

  /// Required normalized short task title.
  title String

  /// Optional full task details; null means no description was supplied.
  description String?

  /// Optional calendar start date stored at UTC midnight; null means unset.
  start_date DateTime?

  /// Optional calendar due date stored at UTC midnight; null means unset.
  due_date DateTime?

  /// Completion state, exactly `incomplete` or `complete`.
  completed Boolean

  /// Availability state, exactly `active` or `trashed`.
  trashed Boolean

  /// Creation instant that never changes through the lifecycle.
  created_at DateTime

  /// Most recent move into trash; null while never trashed or currently active.
  trashed_at DateTime?

  /// Optimistic content version incremented for each accepted content edit.
  content_version Int

  /// Last successful content-edit instant used for stale-edit detection.
  updated_at DateTime

  /// Permanent owner of this Todo.
  user todo_users @relation(fields: [todo_user_id], references: [id], onDelete: Cascade)

  /// Immutable content-edit chronology.
  histories todo_todo_histories[]

  @@index([todo_user_id, trashed, created_at])
  @@index([todo_user_id, trashed, completed])
  @@index([todo_user_id, trashed, trashed_at])
}


model todo_todo_histories {
  /// Application-assigned UUID.
  id String @id

  /// Todo UUID whose content was edited.
  todo_todo_id String

  /// Edit instant, ordered newest first in the public history operation.
  created_at DateTime

  /// Changed-to title; null means title did not participate in this edit.
  title String?

  /// Changed-to description; null means absent, while empty string records a clear.
  description String?

  /// Changed-to start date; null means absent or explicitly cleared by a flag.
  start_date DateTime?

  /// Changed-to due date; null means absent or explicitly cleared by a flag.
  due_date DateTime?

  /// Whether the description value participated, including an explicit clear.
  description_changed Boolean

  /// Whether the start date value participated, including an explicit clear.
  start_date_changed Boolean

  /// Whether the due date value participated, including an explicit clear.
  due_date_changed Boolean

  /// Todo whose content edit this entry records.
  todo todo_todos @relation(fields: [todo_todo_id], references: [id], onDelete: Cascade)

  @@index([todo_todo_id, created_at])
}

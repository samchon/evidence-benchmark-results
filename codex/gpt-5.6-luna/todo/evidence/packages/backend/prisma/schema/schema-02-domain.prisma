/// Private Todo owned by one account with independent completion and trash
/// availability dimensions.
///
/// @evidence docs/analysis/02-domain-model.md#req-dom-todo-todo-meaning-and-ownership Persists task ownership.
/// @evidence docs/analysis/02-domain-model.md#req-dom-todo-1-define-todo-information Persists task content and dates.
/// @evidence docs/analysis/02-domain-model.md#req-dom-todo-2-bind-each-todo-to-one-account Persists ownership.
/// @evidence docs/analysis/02-domain-model.md#req-dom-todo-life-todo-lifecycle Persists lifecycle state.
/// @evidence docs/analysis/02-domain-model.md#req-dom-todo-life-1-define-completion-states Persists completion.
/// @evidence docs/analysis/02-domain-model.md#req-dom-todo-life-2-define-active-and-trashed-availability Persists availability.
/// @evidence docs/analysis/02-domain-model.md#req-dom-todo-life-3-move-an-active-todo-to-trash Persists trash-entry time.
/// @evidence docs/analysis/02-domain-model.md#req-dom-todo-life-4-restore-a-trashed-todo Retains restorable state.
/// @evidence docs/analysis/02-domain-model.md#req-dom-todo-life-5-permanently-delete-a-trashed-todo Owns terminal deletion.
/// @evidence docs/analysis/04-business-rules.md#req-rule-content-todo-content-and-date-rules Stores validated content.
/// @evidence docs/analysis/04-business-rules.md#req-rule-content-1-validate-todo-title-and-description Stores content boundaries.
/// @evidence docs/analysis/04-business-rules.md#req-rule-content-2-validate-todo-planning-dates Stores planning dates.
/// @evidence docs/analysis/04-business-rules.md#req-rule-browse-todo-browsing-rules Indexes browse state.
/// @evidence docs/analysis/04-business-rules.md#req-rule-browse-1-bound-todo-list-pagination Supports bounded lists.
/// @evidence docs/analysis/04-business-rules.md#req-rule-browse-2-filter-active-todos-by-completion Stores filterable completion.
/// @evidence docs/analysis/04-business-rules.md#req-rule-browse-3-sort-active-todos-by-supported-dates Stores sortable dates.
/// @evidence docs/analysis/04-business-rules.md#req-rule-browse-4-apply-stable-default-and-tie-break-ordering Stores stable keys.
/// @evidence docs/analysis/04-business-rules.md#req-rule-state-todo-state-conflict-and-history-rules Represents state transitions.
/// @evidence docs/analysis/04-business-rules.md#req-rule-state-1-qualify-operations-by-todo-availability Represents active/trash state.
/// @evidence docs/analysis/04-business-rules.md#req-rule-state-2-make-repeated-completion-requests-idempotent Stores completion state.
/// @evidence docs/analysis/04-business-rules.md#req-rule-state-3-refuse-no-op-and-stale-content-edits Stores update timestamps.
/// @evidence docs/analysis/04-business-rules.md#req-rule-state-4-create-immutable-content-edit-history Relates immutable history.
/// @evidence docs/analysis/05-non-functional.md#req-nfr-integrity-change-and-deletion-integrity Represents integrity state.
/// @evidence docs/analysis/05-non-functional.md#req-nfr-integrity-1-keep-todo-edits-and-history-consistent Relates Todo and history.
/// @evidence docs/analysis/05-non-functional.md#req-nfr-integrity-2-preserve-recoverable-todo-state Retains recoverable content.
/// @evidence docs/analysis/05-non-functional.md#req-nfr-integrity-3-complete-permanent-deletion-as-one-outcome Cascades terminal deletion.
/// @evidence docs/analysis/03-functional-requirements.md#req-func-todo-todo-operations Represents Todo operation state.
/// @evidence docs/analysis/03-functional-requirements.md#req-func-todo-1-create-a-todo Represents created Todo state.
/// @evidence docs/analysis/03-functional-requirements.md#req-func-todo-2-browse-active-todos Represents active list state.
/// @evidence docs/analysis/03-functional-requirements.md#req-func-todo-3-view-an-active-todo Represents active detail state.
/// @evidence docs/analysis/03-functional-requirements.md#req-func-todo-4-edit-todo-content Represents editable state.
/// @evidence docs/analysis/03-functional-requirements.md#req-func-todo-5-mark-a-todo-complete Represents completion state.
/// @evidence docs/analysis/03-functional-requirements.md#req-func-todo-6-mark-a-todo-incomplete Represents completion state.
/// @evidence docs/analysis/03-functional-requirements.md#req-func-todo-7-move-a-todo-to-trash Represents trash state.
/// @evidence docs/analysis/03-functional-requirements.md#req-func-history-edit-history-inspection Represents retained history state.
/// @evidence docs/analysis/03-functional-requirements.md#req-func-history-1-view-a-todos-full-edit-history Represents retained history rows.
/// @evidence docs/analysis/03-functional-requirements.md#req-func-trash-trash-recovery-journey Represents retained Todo state.
/// @evidence docs/analysis/03-functional-requirements.md#req-func-trash-1-browse-trashed-todos Represents trash list state.
/// @evidence docs/analysis/03-functional-requirements.md#req-func-trash-2-view-a-trashed-todo Represents trash detail state.
/// @evidence docs/analysis/03-functional-requirements.md#req-func-trash-3-restore-a-todo-from-trash Represents restorable state.
/// @evidence docs/analysis/03-functional-requirements.md#req-func-trash-4-permanently-delete-a-todo-from-trash Represents terminal trash state.
model todo_todos {
  /// Application-assigned UUID.
  id String @id

  /// Owning account identifier.
  todo_account_id String

  /// Required task title after trimming.
  title String

  /// Optional task description; null means empty.
  description String?

  /// Optional calendar start date at UTC midnight.
  start_date DateTime?

  /// Optional calendar due date at UTC midnight.
  due_date DateTime?

  /// Completion state; false is incomplete and true is complete.
  completed Boolean

  /// Original creation instant.
  created_at DateTime

  /// Last content or completion update instant.
  updated_at DateTime

  /// Most recent move-to-trash instant; null means active.
  trashed_at DateTime?

  /// Owning account.
  account todo_accounts @relation(fields: [todo_account_id], references: [id], onDelete: Cascade)

  /// Immutable content-edit chronology.
  histories todo_todo_histories[]

  @@index([todo_account_id, trashed_at])
  @@index([todo_account_id, created_at])
  @@index([todo_account_id, trashed_at, created_at])
}

/// Immutable changed-to values for one accepted Todo content edit.
///
/// @evidence docs/analysis/02-domain-model.md#req-dom-history-edit-history-meaning-and-relationship Represents retained chronology.
/// @evidence docs/analysis/02-domain-model.md#req-dom-history-1-define-an-edit-history-entry Represents changed-to values.
/// @evidence docs/analysis/02-domain-model.md#req-dom-history-2-bind-history-to-its-todo-lifecycle Binds history to Todo lifecycle.
model todo_todo_histories {
  /// Application-assigned UUID.
  id String @id

  /// Owning Todo identifier.
  todo_todo_id String

  /// Edit instant.
  created_at DateTime

  /// Whether title participated in this edit.
  title_changed Boolean

  /// Changed-to title when title_changed is true.
  title String?

  /// Whether description participated in this edit.
  description_changed Boolean

  /// Changed-to description; null means explicitly cleared.
  description String?

  /// Whether start date participated in this edit.
  start_date_changed Boolean

  /// Changed-to start date; null means explicitly cleared.
  start_date DateTime?

  /// Whether due date participated in this edit.
  due_date_changed Boolean

  /// Changed-to due date; null means explicitly cleared.
  due_date DateTime?

  /// Owning Todo.
  todo todo_todos @relation(fields: [todo_todo_id], references: [id], onDelete: Cascade)

  @@index([todo_todo_id, created_at])
}

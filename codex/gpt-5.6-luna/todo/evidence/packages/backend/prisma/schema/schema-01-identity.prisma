  id String @id

  /// Canonical lower-case, trimmed email used as the stable login identity.
  email String @unique

  /// Scrypt-derived password verifier; plaintext passwords are never stored.
  password_hash String

  /// Account creation instant.
  created_at DateTime

  /// Last credential or account metadata update instant.
  updated_at DateTime


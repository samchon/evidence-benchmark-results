  profile todo_profiles?

  /// Authenticated sessions issued for this account.
  sessions todo_sessions[]

  /// Todos permanently owned by this account.
  todos todo_todos[]

  /// Recovery proofs delivered to this account's registered email.
  recovery_tokens todo_recovery_tokens[]
}


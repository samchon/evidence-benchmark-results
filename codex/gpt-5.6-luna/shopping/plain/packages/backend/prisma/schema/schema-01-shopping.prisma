/// A customer or seller identity.
model shopping_users {
  id               String   @id
  kind             String
  email            String
  password_hash    String
  display_name     String?
  phone            String?
  shop_name        String?
  shop_description String?
  shop_logo        String?
  approval_status  String?
  rejection_reason String?
  suspended        Boolean  @default(false)
  banned           Boolean  @default(false)
  deleted_at       DateTime?
  grades           String   @default("")
  created_at       DateTime
  updated_at       DateTime
  sessions         shopping_sessions[]
  addresses        shopping_addresses[]
  products         shopping_products[]
  wishlist         shopping_wishlists[]
  cart             shopping_cart_lines[]
  orders           shopping_orders[]
  reviews          shopping_reviews[]
  seller_approvals shopping_seller_approvals[]
  admin_apps       shopping_admin_applications[]
  checkout_sessions shopping_checkout_sessions[]
  recovery_tokens  shopping_recovery_tokens[]
  admin_actions    shopping_admin_actions[] @relation("AdminActionActor")
  seller_profile_snapshots shopping_seller_profile_snapshots[]
  @@unique([kind, email])
  @@index([kind, created_at])
}

/// An authenticated session.
model shopping_sessions {
  id               String   @id
  shopping_user_id String
  token            String   @unique
  refresh_token    String   @unique
  created_at       DateTime
  expires_at       DateTime
  revoked          Boolean  @default(false)
  user             shopping_users @relation(fields: [shopping_user_id], references: [id], onDelete: Cascade)
  @@index([shopping_user_id])
}

/// A saved customer shipping address.
model shopping_addresses {
  id               String   @id
  shopping_user_id String
  recipient_name   String
  phone            String
  street_address   String
  city             String
  state            String
  postal_code      String
  country          String
  is_default       Boolean  @default(false)
  created_at       DateTime
  updated_at       DateTime
  user             shopping_users @relation(fields: [shopping_user_id], references: [id], onDelete: Cascade)
  @@index([shopping_user_id])
}

/// A two-level product category.
model shopping_categories {
  id          String   @id
  parent_id   String?
  name        String
  description String
  created_at  DateTime
  updated_at  DateTime
  parent      shopping_categories? @relation("CategoryTree", fields: [parent_id], references: [id], onDelete: Cascade)
  children    shopping_categories[] @relation("CategoryTree")
  products    shopping_products[]
}

/// A seller-owned live product.
model shopping_products {
  id                  String   @id
  shopping_seller_id  String
  shopping_category_id String?
  name                String
  description         String
  base_price          Float
  created_at          DateTime
  updated_at          DateTime
  deleted_at          DateTime?
  seller              shopping_users @relation(fields: [shopping_seller_id], references: [id])
  category            shopping_categories? @relation(fields: [shopping_category_id], references: [id], onDelete: SetNull)
  images              shopping_product_images[]
  variants            shopping_variants[]
  snapshots           shopping_product_snapshots[]
  wishlist            shopping_wishlists[]
  reviews             shopping_reviews[]
  @@index([shopping_seller_id, deleted_at])
  @@index([shopping_category_id])
}

/// An ordered product image.
model shopping_product_images {
  id                  String   @id
  shopping_product_id String
  uri                 String
  sequence            Int
  created_at          DateTime
  product             shopping_products @relation(fields: [shopping_product_id], references: [id], onDelete: Cascade)
  @@unique([shopping_product_id, sequence])
}

/// A seller SKU variant.
model shopping_variants {
  id                  String   @id
  shopping_product_id String
  sku                 String
  options_json        String
  price_override      Float?
  created_at          DateTime
  updated_at          DateTime
  deleted_at          DateTime?
  product             shopping_products @relation(fields: [shopping_product_id], references: [id], onDelete: Cascade)
  movements           shopping_inventory_movements[]
  cart_lines          shopping_cart_lines[]
  checkout_lines      shopping_checkout_lines[]
  holds               shopping_inventory_holds[]
  order_items         shopping_order_items[]
  @@unique([sku])
}

/// An immutable stock movement.
model shopping_inventory_movements {
  id                  String   @id
  shopping_variant_id String
  quantity            Int
  reason              String
  created_at          DateTime
  variant             shopping_variants @relation(fields: [shopping_variant_id], references: [id], onDelete: Cascade)
  @@index([shopping_variant_id, created_at])
}

/// A reviewable checkout candidate, before an order exists.
model shopping_checkout_sessions {
  id                  String   @id
  shopping_user_id    String
  shopping_address_id String?
  recipient_name      String
  phone               String
  street_address      String
  city                String
  state               String
  postal_code         String
  country             String
  total               Float
  status              String
  created_at          DateTime
  updated_at          DateTime
  user                shopping_users @relation(fields: [shopping_user_id], references: [id], onDelete: Cascade)
  lines               shopping_checkout_lines[]
  attempts            shopping_payment_attempts[]
  @@index([shopping_user_id, status, created_at])
  @@index([shopping_address_id])
}

/// A checkout candidate line copied from the cart.
model shopping_checkout_lines {
  id                       String   @id
  shopping_checkout_id     String
  shopping_variant_id      String?
  product_id               String
  product_name             String
  variant_sku              String
  unit_price               Float
  quantity                 Int
  checkout                 shopping_checkout_sessions @relation(fields: [shopping_checkout_id], references: [id], onDelete: Cascade)
  variant                  shopping_variants? @relation(fields: [shopping_variant_id], references: [id], onDelete: SetNull)
  @@index([shopping_checkout_id])
}

/// One idempotent external payment attempt for a checkout.
model shopping_payment_attempts {
  id                       String   @id
  shopping_checkout_id     String
  attempt_key              String   @unique
  status                   String
  amount                   Float?
  order_id                 String?
  created_at               DateTime
  finalized_at             DateTime?
  checkout                 shopping_checkout_sessions @relation(fields: [shopping_checkout_id], references: [id], onDelete: Cascade)
  holds                    shopping_inventory_holds[]
  @@index([shopping_checkout_id, status])
}

/// A temporary quantity reservation held during payment.
model shopping_inventory_holds {
  id                       String   @id
  shopping_payment_id      String
  shopping_variant_id      String
  quantity                 Int
  status                   String
  created_at               DateTime
  payment                  shopping_payment_attempts @relation(fields: [shopping_payment_id], references: [id], onDelete: Cascade)
  variant                  shopping_variants @relation(fields: [shopping_variant_id], references: [id], onDelete: Cascade)
  @@index([shopping_variant_id, status])
}

/// A short-lived credential recovery challenge.
model shopping_recovery_tokens {
  id               String   @id
  shopping_user_id String
  token            String   @unique
  expires_at       DateTime
  used             Boolean  @default(false)
  created_at       DateTime
  user             shopping_users @relation(fields: [shopping_user_id], references: [id], onDelete: Cascade)
  @@index([shopping_user_id, used, expires_at])
}

/// A customer wishlist membership.
model shopping_wishlists {
  id                  String   @id
  shopping_user_id    String
  shopping_product_id String
  created_at          DateTime
  user                shopping_users @relation(fields: [shopping_user_id], references: [id], onDelete: Cascade)
  product             shopping_products @relation(fields: [shopping_product_id], references: [id], onDelete: Cascade)
  @@unique([shopping_user_id, shopping_product_id])
}

/// A customer cart line.
model shopping_cart_lines {
  id                  String   @id
  shopping_user_id    String
  shopping_variant_id String
  quantity            Int
  created_at          DateTime
  updated_at          DateTime
  user                shopping_users @relation(fields: [shopping_user_id], references: [id], onDelete: Cascade)
  variant             shopping_variants @relation(fields: [shopping_variant_id], references: [id], onDelete: Cascade)
  @@unique([shopping_user_id, shopping_variant_id])
}

/// A completed customer order.
model shopping_orders {
  id                   String   @id
  order_number         String   @unique
  shopping_customer_id String
  total                Float
  status               String
  recipient_name       String
  phone                String
  street_address       String
  city                 String
  state                String
  postal_code          String
  country              String
  created_at           DateTime
  customer             shopping_users @relation(fields: [shopping_customer_id], references: [id])
  items                shopping_order_items[]
  shipments            shopping_shipments[]
}

/// A seller-attributed purchased line.
model shopping_order_items {
  id                    String   @id
  shopping_order_id     String
  shopping_variant_id   String?
  shopping_seller_id    String
  product_id            String
  product_name          String
  product_description   String
  variant_sku           String
  variant_options_json  String
  seller_shop_name      String
  seller_shop_logo      String?
  unit_price            Float
  quantity              Int
  status                String
  refunded_amount       Float?
  purchased_at          DateTime
  delivered_at          DateTime?
  order                 shopping_orders @relation(fields: [shopping_order_id], references: [id], onDelete: Cascade)
  variant               shopping_variants? @relation(fields: [shopping_variant_id], references: [id], onDelete: SetNull)
  shipment_items        shopping_shipment_items[]
  requests              shopping_requests[]
  @@index([shopping_seller_id, status, purchased_at])
}

/// A shipment containing one seller's order items.
model shopping_shipments {
  id                   String   @id
  shopping_order_id    String
  shopping_seller_id   String
  carrier              String
  tracking_number      String
  shipped_at           DateTime
  delivered_at         DateTime?
  order                shopping_orders @relation(fields: [shopping_order_id], references: [id], onDelete: Cascade)
  items                shopping_shipment_items[]
}

/// Shipment-to-item composition link.
model shopping_shipment_items {
  id                    String   @id
  shopping_shipment_id  String
  shopping_order_item_id String  @unique
  shipment              shopping_shipments @relation(fields: [shopping_shipment_id], references: [id], onDelete: Cascade)
  item                  shopping_order_items @relation(fields: [shopping_order_item_id], references: [id], onDelete: Cascade)
}

/// A cancellation or refund request.
model shopping_requests {
  id                    String   @id
  shopping_order_item_id String
  kind                  String
  reason                String
  status                String
  created_at            DateTime
  decided_at            DateTime?
  item                  shopping_order_items @relation(fields: [shopping_order_item_id], references: [id], onDelete: Cascade)
  snapshots             shopping_request_snapshots[]
  @@index([shopping_order_item_id, kind, status])
}

/// A live product review.
model shopping_reviews {
  id                  String   @id
  shopping_user_id    String
  shopping_product_id String
  shopping_order_id   String
  rating              Int
  text                String?
  created_at          DateTime
  updated_at          DateTime
  deleted_at          DateTime?
  user                shopping_users @relation(fields: [shopping_user_id], references: [id])
  product             shopping_products @relation(fields: [shopping_product_id], references: [id])
  snapshots           shopping_review_snapshots[]
  @@unique([shopping_user_id, shopping_product_id, shopping_order_id])
}

/// An immutable review edit record.
model shopping_review_snapshots {
  id                  String   @id
  shopping_review_id  String
  before_rating       Int
  after_rating        Int
  before_text        String?
  after_text         String?
  created_at          DateTime
  review              shopping_reviews @relation(fields: [shopping_review_id], references: [id], onDelete: Restrict)
}

/// A seller approval submission.
model shopping_seller_approvals {
  id                  String   @id
  shopping_seller_id  String
  status              String
  reason              String?
  created_at          DateTime
  decided_at          DateTime?
  decided_by_id       String?
  seller              shopping_users @relation(fields: [shopping_seller_id], references: [id], onDelete: Cascade)
  @@index([status, created_at])
}

/// An administrator application.
model shopping_admin_applications {
  id                  String   @id
  shopping_user_id    String
  reason              String
  status              String
  created_at          DateTime
  decided_at          DateTime?
  decided_by_id       String?
  user                shopping_users @relation(fields: [shopping_user_id], references: [id], onDelete: Cascade)
  @@index([status, created_at])
}

/// An immutable product aggregate snapshot.
model shopping_product_snapshots {
  id                  String   @id
  shopping_product_id String
  before_json         String
  after_json          String
  changed_fields      String
  created_at          DateTime
  product             shopping_products @relation(fields: [shopping_product_id], references: [id], onDelete: Restrict)
  @@index([shopping_product_id, created_at])
}

/// Immutable seller profile revision evidence.
model shopping_seller_profile_snapshots {
  id               String         @id
  shopping_seller_id String
  before_json      String
  after_json       String
  changed_fields   String
  created_at       DateTime
  seller           shopping_users  @relation(fields: [shopping_seller_id], references: [id], onDelete: Restrict)
  @@index([shopping_seller_id, created_at])
}

/// Immutable cancellation/refund request state evidence.
model shopping_request_snapshots {
  id                    String                @id
  shopping_request_id   String
  actor_id              String
  actor_kind            String
  before_status         String
  after_status          String
  before_reason         String
  after_reason          String
  created_at            DateTime
  request               shopping_requests     @relation(fields: [shopping_request_id], references: [id], onDelete: Restrict)
  @@index([shopping_request_id, created_at])
}

/// Immutable administrator moderation and forced-action evidence.
model shopping_admin_actions {
  id               String   @id
  actor_id         String
  target_kind      String
  target_id        String
  action           String
  reason           String
  outcome_json     String
  created_at       DateTime
  actor            shopping_users @relation("AdminActionActor", fields: [actor_id], references: [id], onDelete: Restrict)
  @@index([target_kind, target_id, created_at])
  @@index([actor_id, created_at])
}

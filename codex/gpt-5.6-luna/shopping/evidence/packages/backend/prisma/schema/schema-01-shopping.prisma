model shopping_orders {
  /// UUID primary key.
  id                       String                 @id
  /// Owning customer identifier.
  shopping_customer_id     String
  /// Fixed purchase total.
  total_price              Float
  /// Purchase-time shipping values.
  shipping_recipient_name  String
  /// Purchase-time shipping phone.
  shipping_recipient_phone String
  /// Purchase-time street address.
  shipping_street_address  String
  /// Purchase-time city.
  shipping_city            String
  /// Purchase-time state or province.
  shipping_state           String
  /// Purchase-time postal code.
  shipping_postal_code     String
  /// Purchase-time country.
  shipping_country         String
  /// Creation instant.
  created_at               DateTime
  /// Customer relation.
  customer                 shopping_customers     @relation(fields: [shopping_customer_id], references: [id], onDelete: Restrict)
  /// Purchased items.
  items                    shopping_order_items[]

  @@index([shopping_customer_id, created_at])
}


}

/// One reusable authentication session for a customer.
model shopping_customer_sessions {
  /// Application UUID.
  id String @id
  /// Owning customer identifier.
  customer_id String
  /// Stored refresh-token digest.
  refresh_token_hash String @unique
  /// Session creation instant.
  created_at DateTime
  /// Session expiry instant.
  expired_at DateTime
  /// Revocation instant; null means usable if the account is eligible.
  revoked_at DateTime?
  /// Owning customer.
  customer shopping_customers @relation(fields: [customer_id], references: [id], onDelete: Cascade)
  @@index([customer_id, revoked_at])
}

/// The one editable profile attached to a customer identity.
model shopping_customer_profiles {
  /// Application UUID.
  id String @id
  /// Owning customer identifier.
  customer_id String @unique
  /// Customer-facing display name.
  display_name String
  /// Customer contact phone number.
  phone_number String
  /// Profile creation instant.
  created_at DateTime
  /// Last profile edit instant.
  updated_at DateTime
  /// Owning customer.
  customer shopping_customers @relation(fields: [customer_id], references: [id], onDelete: Cascade)
}

/// A reusable customer-owned delivery destination.
model shopping_customer_addresses {
  /// Application UUID.
  id String @id
  /// Owning customer identifier.
  customer_id String

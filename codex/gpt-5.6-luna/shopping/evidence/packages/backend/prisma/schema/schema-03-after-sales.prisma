  actor_type String
  /// Applicant identity identifier.
  actor_id String
  /// Applicant reason.
  reason String
  /// Pending, approved, or rejected.
  status String
  /// Decision actor identifier.
  decided_by String?
  /// Submission instant.
  created_at DateTime
  /// Decision instant, absent while pending.
  decided_at DateTime?
  @@index([actor_type, actor_id, status, created_at])
}

/// Immutable administrator moderation and force-resolution evidence.
model shopping_moderation_events {
  /// Application UUID.
  id String @id
  /// Administrator actor identifier.
  administrator_id String
  /// Target kind.
  target_type String
  /// Target identifier.
  target_id String
  /// Action kind.
  action String
  /// Nonblank policy reason.
  reason String
  /// Prior state.
  before_state String
  /// Resulting state.
  after_state String
  /// Action instant.
  created_at DateTime
  @@index([target_type, target_id, created_at])
}

/// @evidence docs/analysis/02-domain-model.md#req-review-domain-3-limit-reviews-per-purchase Stores the persisted state required by this unit.
/// @evidence docs/analysis/02-domain-model.md#req-review-domain-4-retire-a-review-from-ratings Stores the persisted state required by this unit.
/// @evidence docs/analysis/02-domain-model.md#req-review-domain-5-anonymize-reviews-after-customer-deletion Stores the persisted state required by this unit.
/// @evidence docs/analysis/02-domain-model.md#req-review-lifecycle-1-publish-an-eligible-review Stores the persisted state required by this unit.
/// @evidence docs/analysis/02-domain-model.md#req-review-lifecycle-2-edit-a-published-review Stores the persisted state required by this unit.
/// @evidence docs/analysis/02-domain-model.md#req-review-lifecycle-3-delete-a-published-review Stores the persisted state required by this unit.
/// @evidence docs/analysis/02-domain-model.md#req-review-lifecycle-4-anonymize-reviews-on-account-closure Stores the persisted state required by this unit.
/// @evidence docs/analysis/03-functional-requirements.md#req-review-functions-2-edit-an-authored-review Stores the persisted state required by this unit.
/// @evidence docs/analysis/03-functional-requirements.md#req-review-functions-3-delete-an-authored-review Stores the persisted state required by this unit.
/// @evidence docs/analysis/04-business-rules.md#req-review-policies-1-require-a-verified-delivered-purchase Stores the persisted state required by this unit.
/// @evidence docs/analysis/04-business-rules.md#req-review-policies-2-validate-review-rating-and-optional-text Stores the persisted state required by this unit.
/// @evidence docs/analysis/04-business-rules.md#req-review-policies-4-keep-review-mutation-with-the-author Stores the persisted state required by this unit.
/// @evidence docs/analysis/04-business-rules.md#req-review-policies-5-order-live-reviews-by-publication-time Stores the persisted state required by this unit.
/// @evidence docs/analysis/04-business-rules.md#req-review-policies-7-anonymize-retained-reviews-after-account-deletion Stores the persisted state required by this unit.
model shopping_reviews {
  /// Application UUID.
  id String @id
  /// Author identifier retained for history.
  customer_id String
  /// Reviewed product identifier retained after deletion.
  product_id String
  /// Qualifying order identifier.
  order_id String
  /// Rating from one through five.
  rating Int
  /// Optional review text.
  text String?
  /// Original publication instant.
  published_at DateTime
  /// Last edit instant.
  updated_at DateTime
  /// Retirement instant; account closure does not set this.
  deleted_at DateTime?
  /// Whether the author identity is presented anonymously.
  anonymized Boolean
  /// Customer author.
  customer shopping_customers @relation(fields: [customer_id], references: [id], onDelete: Restrict)
  /// Product target.
  product shopping_products @relation(fields: [product_id], references: [id], onDelete: Restrict)
  /// Immutable review edits.
  snapshots shopping_review_snapshots[]
  @@unique([customer_id, product_id, order_id])
  @@index([product_id, deleted_at, published_at])
}

/// Immutable review before-and-after evidence.
model shopping_review_snapshots {
  /// Application UUID.
  id String @id
  /// Retained review identifier.
  review_id String
  /// Prior rating.
  before_rating Int
  /// Resulting rating.
  after_rating Int
  /// Prior text, including null as absent.
  before_text String?
  /// Resulting text, including null as absent.
  after_text String?
  /// Changed-field description.
  changed_fields String
  /// Capture instant.
  created_at DateTime
  /// Review whose edit was captured.
  review shopping_reviews @relation(fields: [review_id], references: [id], onDelete: Restrict)
  @@index([review_id, created_at])
}


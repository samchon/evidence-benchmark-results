/// @evidence docs/analysis/03-functional-requirements.md#req-shipping-functions-1-list-items-awaiting-shipment Stores the persisted state required by this unit.
/// @evidence docs/analysis/03-functional-requirements.md#req-shipping-functions-2-create-a-shipment Stores the persisted state required by this unit.
/// @evidence docs/analysis/03-functional-requirements.md#req-shipping-functions-3-view-shipment-tracking Stores the persisted state required by this unit.
/// @evidence docs/analysis/03-functional-requirements.md#req-shipping-functions-4-confirm-shipment-delivery Stores the persisted state required by this unit.
/// @evidence docs/analysis/03-functional-requirements.md#req-shipping-functions-5-auto-confirm-shipment-delivery Stores the persisted state required by this unit.
/// @evidence docs/analysis/04-business-rules.md#req-shipment-policies-1-select-eligible-paid-items-for-shipment Stores the persisted state required by this unit.
/// @evidence docs/analysis/04-business-rules.md#req-shipment-policies-2-keep-one-seller-and-destination-per-shipment Stores the persisted state required by this unit.
/// @evidence docs/analysis/04-business-rules.md#req-shipment-policies-3-require-complete-shared-tracking-information Stores the persisted state required by this unit.
/// @evidence docs/analysis/04-business-rules.md#req-shipment-policies-4-ship-all-package-items-together Stores the persisted state required by this unit.
/// @evidence docs/analysis/04-business-rules.md#req-shipment-policies-5-confirm-delivery-for-the-whole-shipment Stores the persisted state required by this unit.
/// @evidence docs/analysis/04-business-rules.md#req-shipment-policies-6-complete-unconfirmed-shipments-after-fourteen-days Stores the persisted state required by this unit.
model shopping_shipments {
  /// Application UUID.
  id String @id
  /// Parent order identifier.
  order_id String
  /// Seller responsible for the package.
  seller_id String
  /// Carrier name.
  carrier String
  /// Carrier tracking number.
  tracking_number String
  /// Shipment creation instant.
  shipped_at DateTime
  /// Delivery confirmation or automatic completion instant.
  delivered_at DateTime?
  /// Order owner.
  order shopping_orders @relation(fields: [order_id], references: [id], onDelete: Restrict)
  /// Seller owner.
  seller shopping_sellers @relation(fields: [seller_id], references: [id], onDelete: Restrict)
  /// Included order items.
  items shopping_shipment_items[]
  @@index([seller_id, shipped_at])
}

/// Join row assigning one whole order item to a shipment.
model shopping_shipment_items {
  /// Application UUID.
  id String @id
  /// Shipment identifier.
  shipment_id String
  /// Order item identifier.
  order_item_id String @unique
  /// Shipment.
  shipment shopping_shipments @relation(fields: [shipment_id], references: [id], onDelete: Restrict)
  /// Order item.
  order_item shopping_order_items @relation(fields: [order_item_id], references: [id], onDelete: Restrict)
  @@index([shipment_id])
}


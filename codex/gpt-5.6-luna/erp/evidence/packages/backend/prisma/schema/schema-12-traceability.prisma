/// Lot identity and availability for a lot-tracked inventory item.
/// @evidence docs/analysis/02-domain-model.md#req-dom-lot-inventory-lots Preserves organization, item, code, origin, status, and dates.
/// @evidence docs/analysis/04-business-rules.md#req-rule-lot-inventory-lot-rules Preserves lot identity and traceability state.
model inventory_lots {
  id String @id
  organization_id String
  item_id String
  lot_code String
  origin String?
  status String
  received_at DateTime?
  expires_at DateTime?
  quantity Decimal
  created_at DateTime
  updated_at DateTime
  organization organizations @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  item items @relation(fields: [item_id], references: [id], onDelete: Restrict)
  serials item_serials[]
  @@unique([organization_id, lot_code])
  @@index([organization_id, item_id, status])
}

/// Physical unit serial identity within one item.
/// @evidence docs/analysis/02-domain-model.md#req-dom-serial-item-serials Retains item, lot, code, status, and stock context.
/// @evidence docs/analysis/04-business-rules.md#req-rule-serial-item-serial-rules Preserves serial identity and lifecycle.
model item_serials {
  id String @id
  organization_id String
  item_id String
  lot_id String?
  serial_code String
  status String
  location_id String?
  origin String?
  created_at DateTime
  updated_at DateTime
  organization organizations @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  item items @relation(fields: [item_id], references: [id], onDelete: Restrict)
  lot inventory_lots? @relation(fields: [lot_id], references: [id], onDelete: SetNull)
  @@unique([item_id, serial_code])
  @@index([organization_id, item_id, status])
}

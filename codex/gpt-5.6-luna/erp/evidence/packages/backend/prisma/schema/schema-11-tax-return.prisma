/// Organization tax filing and immutable amendment history.
/// @evidence docs/analysis/02-domain-model.md#req-dom-tax-return-tax-return-lifecycle Preserves jurisdiction, period, workflow status, and filed versions.
/// @evidence docs/analysis/03-functional-requirements.md#req-fun-tax-return-tax-return-operations Owns tax-return review, filing, and amendment history.
/// @evidence docs/analysis/04-business-rules.md#req-rule-tax-tax-return-filing-rules Preserves filed-return immutability and amendment lineage.
model tax_returns {
  id String @id
  organization_id String
  jurisdiction_id String
  period_start DateTime
  period_end DateTime
  status String
  total_tax Decimal
  notes String?
  original_return_id String?
  version Int
  filed_at DateTime?
  created_by_user_id String
  created_at DateTime
  updated_at DateTime
  organization organizations @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  jurisdiction tax_jurisdictions @relation(fields: [jurisdiction_id], references: [id], onDelete: Restrict)
  original_return tax_returns? @relation("TaxReturnVersions", fields: [original_return_id], references: [id], onDelete: Restrict)
  versions tax_returns[] @relation("TaxReturnVersions")
  @@index([organization_id, period_end, status])
  @@unique([organization_id, jurisdiction_id, period_start, period_end, version])
}

/// Organization department with optional manager responsibility.
/// @evidence docs/analysis/02-domain-model.md#req-dom-department-departments Stores department identity and scoped manager.
/// @evidence docs/analysis/03-functional-requirements.md#req-fun-department-department-operations Owns department hierarchy and manager assignment.
/// @evidence docs/analysis/01-actors-and-auth.md#req-auth-position-scoped-manager-positions Retains scoped department manager responsibility.
model departments {
  id String @id
  organization_id String
  code String
  name String
  manager_user_id String?
  active Boolean
  created_at DateTime
  updated_at DateTime
  organization organizations @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  employees employees[]
  @@unique([organization_id, code])
}

/// Organization employee record, separate from global credentials.
/// @evidence docs/analysis/02-domain-model.md#req-dom-employee-employee-lifecycle Retains employee identity, placement, and active lifecycle.
/// @evidence docs/analysis/03-functional-requirements.md#req-fun-employee-employee-operations Owns employee placement and lifecycle.
/// @evidence docs/analysis/04-business-rules.md#req-rule-employee-employee-identity-and-visibility-rules Preserves employee identity and visibility boundaries.
model employees {
  id String @id
  organization_id String
  employee_number String
  user_id String?
  first_name String
  last_name String
  email String?
  phone String?
  department_id String?
  hire_date DateTime?
  status String
  active Boolean
  created_at DateTime
  updated_at DateTime
  organization organizations @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  department departments? @relation(fields: [department_id], references: [id], onDelete: SetNull)
  @@unique([organization_id, employee_number])
  @@index([organization_id, active])
}

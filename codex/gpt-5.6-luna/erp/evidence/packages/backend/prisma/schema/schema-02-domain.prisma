  id String @id
  /// Owning organization UUID.
  organization_id String
  /// Human-readable identity when the concept has one.
  name String?
  /// Requirement-defined lifecycle status.
  status String?
  /// Requirement-defined description or memo.
  description String?
  /// Source or related record identity when applicable.
  reference_id String?
  /// Requirement-defined quantity when applicable.
  quantity Decimal?
  /// Requirement-defined monetary amount when applicable.
  amount Decimal?
  /// Creation instant.
  created_at DateTime
  /// Last mutable update, when the lifecycle permits changes.
  updated_at DateTime?
  /// Retention marker for deactivated records.
  deleted_at DateTime?
  /// Aggregate-specific fields supplied by the operation and retained as JSON.
  attributes String?

  @@index([organization_id])
  @@index([organization_id, status])
}


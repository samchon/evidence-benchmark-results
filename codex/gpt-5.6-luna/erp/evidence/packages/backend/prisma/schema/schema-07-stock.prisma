/// Immutable source-linked inventory stock movement.
/// @evidence docs/analysis/02-domain-model.md#req-dom-stock-movement-stock-movements Computes stock from immutable quantity movements.
/// @evidence docs/analysis/03-functional-requirements.md#req-fun-stock-view-stock-discovery-and-traceability Owns immutable stock movement facts for discovery and traceability.
/// @evidence docs/analysis/03-functional-requirements.md#req-fun-stock-quarantine-stock-quarantine-operations Retains stock quarantine movements and source linkage.
/// @evidence docs/analysis/04-business-rules.md#req-rule-inventory-stock-quantity-and-valuation-rules Preserves quantity and valuation movement history.
/// @evidence docs/analysis/04-business-rules.md#req-rule-doc-link-006-financial-and-stock-postings-reference-the-source-document-that-generated-them Retains stock source type and identifier attribution.
model stock_movements {
  id String @id
  organization_id String
  item_id String
  warehouse_id String
  location_id String?
  movement_type String
  quantity Decimal
  unit_cost Decimal?
  currency_code String?
  source_type String
  source_id String
  lot_id String?
  serial_id String?
  occurred_at DateTime
  created_at DateTime
  organization organizations @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  @@index([organization_id, item_id, warehouse_id, occurred_at])
  @@index([source_type, source_id])
}

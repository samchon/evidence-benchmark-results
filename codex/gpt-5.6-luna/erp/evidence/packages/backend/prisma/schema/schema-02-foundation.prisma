/// One posting period in a fiscal calendar.
/// @evidence docs/analysis/02-domain-model.md#req-dom-fiscal-period-fiscal-period-lifecycle Records ordered dates and close lifecycle.
/// @evidence docs/analysis/03-functional-requirements.md#req-fun-period-close-fiscal-period-close-and-reopen Owns soft close, hard close, reopening, and reclose state.
/// @evidence docs/analysis/04-business-rules.md#req-rule-period-fiscal-period-rules Preserves fiscal-period posting and close rules.
model fiscal_periods {
  /// UUID primary key.
  id String @id
  /// Fiscal calendar identifier.
  calendar_id String
  /// Period ordinal within the year.

/// Reusable organization-scoped postal or physical address.
/// @evidence docs/analysis/02-domain-model.md#req-dom-address-addresses Stores reusable postal and location facts without replacing party or document identity.
/// @evidence docs/analysis/03-functional-requirements.md#req-fun-address-address-operations Owns reusable address lifecycle and relationship use.
model addresses {
  /// UUID primary key.
  id String @id
  /// Owning organization identifier.
  organization_id String
  /// Address label.
  label String
  /// First address line.
  line1 String
  /// Optional second address line.
  line2 String?
  /// City or locality.
  city String
  /// Region, state, or province.
  region String?
  /// Postal code.
  postal_code String?
  /// ISO country code.
  country_code String
  /// Whether new relationships may select this address.
  active Boolean
  /// Creation instant.
  created_at DateTime
  /// Last revision instant.
  updated_at DateTime

  /// Organization owning this address.
  organization organizations @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  /// Target relationships retaining a named purpose.
  usages address_usages[]

  @@index([organization_id, active])
}

/// Named use of an address by a concrete party, warehouse, or document.
/// @evidence docs/analysis/02-domain-model.md#req-dom-address-addresses Preserves the relationship purpose independently from reusable address identity.
model address_usages {
  /// UUID primary key.
  id String @id
  /// Address identifier.
  address_id String
  /// Concrete target type.
  target_type String
  /// Concrete target identifier.
  target_id String
  /// billing, shipping, or physical purpose.
  purpose String
  /// Creation instant.
  created_at DateTime

  /// Reusable address.
  address addresses @relation(fields: [address_id], references: [id], onDelete: Cascade)

  @@unique([address_id, target_type, target_id, purpose])
  @@index([target_type, target_id])
}

/// Organization-scoped person and communication record.
/// @evidence docs/analysis/02-domain-model.md#req-dom-contact-contacts Records contact identity separately from vendor or customer lifecycle.
/// @evidence docs/analysis/03-functional-requirements.md#req-fun-contact-contact-operations Owns reusable contact lifecycle and assignment.
model contacts {
  /// UUID primary key.
  id String @id
  /// Owning organization identifier.
  organization_id String
  /// Person name.
  name String
  /// Email address, when supplied.
  email String?
  /// Phone number, when supplied.
  phone String?
  /// Whether the contact may be selected for new relationships.
  active Boolean
  /// Creation instant.
  created_at DateTime
  /// Last revision instant.
  updated_at DateTime

  /// Organization owning this contact.
  organization organizations @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  /// Party assignments retaining primary designation.
  party_assignments contact_assignments[]

  @@index([organization_id, active])
}

/// Assignment of a contact to one external party.
/// @evidence docs/analysis/03-functional-requirements.md#req-fun-contact-contact-operations Records explicit party assignment and primary designation.
model contact_assignments {
  /// UUID primary key.
  id String @id
  /// Contact identifier.
  contact_id String
  /// Vendor or customer target type.
  party_type String
  /// Vendor or customer target identifier.
  party_id String
  /// Whether this is the party's primary contact.
  primary Boolean
  /// Creation instant.
  created_at DateTime

  /// Assigned contact.
  contact contacts @relation(fields: [contact_id], references: [id], onDelete: Cascade)

  @@unique([party_type, party_id, contact_id])
  @@index([party_type, party_id, primary])
}

/// File metadata attached to one concrete business target.

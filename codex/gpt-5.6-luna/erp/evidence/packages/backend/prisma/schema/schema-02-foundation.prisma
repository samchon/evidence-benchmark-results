/// Organization-wide custom-field definition.
/// @evidence docs/analysis/02-domain-model.md#req-dom-customfield-custom-fields Defines a target concept and the meaning of retained values.
/// @evidence docs/analysis/03-functional-requirements.md#req-fun-customfield-custom-field-operations Owns custom-field definition lifecycle.
model custom_field_definitions {
  /// UUID primary key.
  id String @id
  /// Owning organization identifier.
  organization_id String
  /// Source-defined target concept.
  target_concept String
  /// Display label.
  label String
  /// text, number, boolean, or date.
  value_kind String
  /// Whether new values may be written.
  active Boolean
  /// Creation instant.
  created_at DateTime
  /// Last definition update instant.
  updated_at DateTime

  /// Organization owning the definition.
  organization organizations @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  /// Values retaining this definition.
  values custom_field_values[]

  @@unique([organization_id, target_concept, label])
}

/// Value of one custom-field definition on one concrete record.
/// @evidence docs/analysis/02-domain-model.md#req-dom-customfield-custom-fields Keeps definition identity with each interpreted target value.
model custom_field_values {
  /// UUID primary key.
  id String @id
  /// Definition identifier.
  definition_id String
  /// Concrete target type.
  target_type String
  /// Concrete target identifier.
  target_id String
  /// Text representation when value kind is text.
  value_text String?
  /// Numeric representation when value kind is number.
  value_number Float?
  /// Boolean representation when value kind is boolean.
  value_boolean Boolean?
  /// Date representation when value kind is date.
  value_date DateTime?
  /// Creation instant.
  created_at DateTime
  /// Last value update instant.
  updated_at DateTime

  /// Definition interpreting this value.
  definition custom_field_definitions @relation(fields: [definition_id], references: [id], onDelete: Cascade)

  @@unique([definition_id, target_type, target_id])
}

/// Organization-supported currency.
/// @evidence docs/analysis/02-domain-model.md#req-dom-currency-currencies Records code, name, and monetary precision.
/// @evidence docs/analysis/03-functional-requirements.md#req-fun-currency-currency-operations Owns organization currency administration.
model currencies {
  /// UUID primary key.
  id String @id
  /// Owning organization identifier.
  organization_id String
  /// ISO currency code.
  code String
  /// Currency display name.
  name String
  /// Number of fractional decimal places.
  precision Int
  /// Whether new transactions may select the currency.
  active Boolean
  /// Creation instant.
  created_at DateTime
  /// Last descriptive update instant.
  updated_at DateTime

  /// Organization owning this supported currency.
  organization organizations @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  /// Exchange rates sourced from this currency.
  source_rates exchange_rates[] @relation("SourceCurrency")
  /// Exchange rates targeted to this currency.
  target_rates exchange_rates[] @relation("TargetCurrency")

  @@unique([organization_id, code])
}

/// Effective-dated exchange rate for one ordered currency pair.
/// @evidence docs/analysis/02-domain-model.md#req-dom-exchange-rate-exchange-rates Retains the exact rate context selected by a posting.
/// @evidence docs/analysis/03-functional-requirements.md#req-fun-exchange-rate-exchange-rate-operations Owns effective-dated rate operations.
model exchange_rates {
  /// UUID primary key.
  id String @id
  /// Owning organization identifier.
  organization_id String
  /// Source currency identifier.
  source_currency_id String
  /// Target currency identifier.
  target_currency_id String
  /// Date from which the rate applies.
  effective_at DateTime
  /// Conversion multiplier.
  rate Decimal
  /// manual or system source.
  origin String
  /// Creation instant.
  created_at DateTime

  /// Organization owning the rate.
  organization organizations @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  /// Source currency.
  source_currency currencies @relation("SourceCurrency", fields: [source_currency_id], references: [id])
  /// Target currency.
  target_currency currencies @relation("TargetCurrency", fields: [target_currency_id], references: [id])

  @@unique([organization_id, source_currency_id, target_currency_id, effective_at])
}


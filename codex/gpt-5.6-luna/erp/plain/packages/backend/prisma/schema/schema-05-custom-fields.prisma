model custom_field_definitions {
 id String @id
 organization_id String
 target_type String
 field_key String
 label String
 value_kind String
 active Boolean
 created_at DateTime
 updated_at DateTime
 organization organizations @relation(fields:[organization_id],references:[id])
 values custom_field_values[]
 @@unique([organization_id,target_type,field_key])
}
model custom_field_values {
 id String @id
 organization_id String
 definition_id String
 target_type String
 target_id String
 value_json String?
 created_at DateTime
 updated_at DateTime
 organization organizations @relation(fields:[organization_id],references:[id])
 definition custom_field_definitions @relation(fields:[definition_id],references:[id])
 @@unique([organization_id,definition_id,target_type,target_id])
}

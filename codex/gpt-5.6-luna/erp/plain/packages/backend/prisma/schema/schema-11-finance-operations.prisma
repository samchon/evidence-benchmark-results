/// Bank account connected to an organization cash ledger.
model bank_accounts {
  id String @id
  organization_id String
  ledger_account_id String
  code String
  name String
  currency_code String
  status String
  balance Decimal
  created_at DateTime
  updated_at DateTime
  organization organizations @relation(fields:[organization_id], references:[id])
  @@unique([organization_id,code])
}
/// Imported or manually recorded bank statement transaction.
model bank_transactions {
  id String @id
  organization_id String
  bank_account_id String
  statement_date DateTime
  amount Decimal
  reference String
  status String
  matched_document_id String?
  created_at DateTime
  updated_at DateTime
  organization organizations @relation(fields:[organization_id], references:[id])
  @@index([organization_id,bank_account_id,statement_date])
}
/// Periodic bank reconciliation and its status.
model reconciliations {
  id String @id
  organization_id String
  bank_account_id String
  period_start DateTime
  period_end DateTime
  status String
  lines_json String
  created_at DateTime
  updated_at DateTime
  organization organizations @relation(fields:[organization_id], references:[id])
  @@index([organization_id,status])
}
/// Tax return preparation, approval, filing, and amendment history.
model tax_returns {
  id String @id
  organization_id String
  jurisdiction_id String
  period_key String
  status String
  amount Decimal
  version Int
  source_return_id String?
  data_json String
  created_at DateTime
  updated_at DateTime
  organization organizations @relation(fields:[organization_id], references:[id])
  @@unique([organization_id,jurisdiction_id,period_key,version])
}
/// Supplier credit balance from returns or bill corrections.
model vendor_credits {
  id String @id
  organization_id String
  vendor_id String
  number String
  status String
  currency_code String
  amount Decimal
  remaining Decimal
  source_document_id String?
  applications_json String
  created_at DateTime
  updated_at DateTime
  organization organizations @relation(fields:[organization_id], references:[id])
  @@unique([organization_id,number])
}

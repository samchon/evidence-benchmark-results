/// A fiscal period.
model fiscal_periods {
  /// Primary key.
  id String @id
  /// Organization identifier.
  organization_id String
  /// Fiscal year identifier when generated by the calendar.
  fiscal_year_id String?
  /// Period label.
  name String
  /// Start date.
  starts_at DateTime
  /// End date.
  ends_at DateTime
  /// Open, soft_closed, hard_closed, or reopened.
  status String
  /// Close cycle number.
  close_cycle Int
  /// Creation instant.
  created_at DateTime
  @@unique([organization_id, name])
}

/// An organization-scoped document number sequence.
model document_number_sequences {
  /// Primary key.
  id String @id
  /// Organization identifier.
  organization_id String
  /// Operational document type.
  document_type String
  /// Human-readable prefix.
  prefix String
  /// Minimum numeric width.
  padding Int
  /// Next number to issue.
  next_value Int
  /// Whether issuance is enabled.
  active Boolean
  /// Creation instant.
  created_at DateTime
  /// Last configuration change.
  updated_at DateTime
  @@unique([organization_id, document_type])
}

/// A generated fiscal year containing twelve calendar periods.
model fiscal_years {
  /// Primary key.
  id String @id
  /// Organization identifier.
  organization_id String
  /// Fiscal-year label.
  name String
  /// First calendar date.
  starts_at DateTime
  /// Last calendar date.
  ends_at DateTime
  /// Open or closed.
  status String
  /// Creation instant.
  created_at DateTime
  @@unique([organization_id, name])
}

/// Per-membership notification delivery preferences.
model notification_preferences {
  /// Primary key.
  id String @id
  /// Organization identifier.
  organization_id String
  /// Membership identifier.
  membership_id String
  /// JSON map of ordinary category settings.
  categories String
  /// JSON map of delivery settings.
  delivery String
  /// Creation instant.
  created_at DateTime
  /// Last change instant.
  updated_at DateTime
  @@unique([organization_id, membership_id])
}

/// A responsibility dimension for expenses and operations.
model cost_centers {
  /// Primary key.
  id String @id
  /// Organization identifier.
  organization_id String
  /// Organization-unique code.
  code String
  /// Name.
  name String
  /// Optional manager employee identifier.
  manager_id String?
  /// Optional parent center.
  parent_id String?
  /// Active or inactive.
  status String
  /// Description.
  description String?
  /// Creation instant.
  created_at DateTime
  /// Last change instant.
  updated_at DateTime
  @@unique([organization_id, code])
}

/// An organization payroll cadence.
model pay_schedules {
  /// Primary key.
  id String @id
  /// Organization identifier.
  organization_id String
  /// Name.
  name String
  /// weekly, biweekly, or monthly.
  frequency String
  /// Period boundary rule.
  period_rule String
  /// Payment-date rule.
  payment_date_rule String
  /// Cutoff day.
  cutoff_day Int
  /// Active lifecycle.
  active Boolean
  /// Creation instant.
  created_at DateTime
  /// Last change instant.
  updated_at DateTime
  @@unique([organization_id, name])
}

/// Sensitive employee payroll calculation configuration.
model payroll_configurations {
  /// Primary key.
  id String @id
  /// Organization identifier.
  organization_id String
  /// Employee identifier.
  employee_id String
  /// Pay schedule identifier.
  schedule_id String
  /// Salary or hourly rate.
  rate Float
  /// monthly or hourly.
  rate_kind String
  /// Tax profile reference.
  tax_profile String?
  /// Benefits enrollment JSON.
  benefits String
  /// Optional bank account.
  bank_account_id String?
  /// Optional cost center.
  cost_center_id String?
  /// Active lifecycle.
  active Boolean
  /// Creation instant.
  created_at DateTime
  /// Last change instant.
  updated_at DateTime
  @@unique([organization_id, employee_id])
}

/// A managerial profit dimension.
model profit_centers {
  /// Primary key.
  id String @id
  /// Organization identifier.
  organization_id String
  /// Organization-unique code.
  code String
  /// Name.
  name String
  /// Optional manager employee identifier.
  manager_id String?
  /// Optional parent center.
  parent_id String?
  /// Active or inactive.
  status String
  /// Description.
  description String?
  /// Creation instant.
  created_at DateTime
  /// Last change instant.
  updated_at DateTime
  @@unique([organization_id, code])
}

/// A reusable expense allocation rule.
model allocation_rules {
  /// Primary key.
  id String @id
  /// Organization identifier.
  organization_id String
  /// Source cost center identifier.
  source_cost_center_id String
  /// JSON destination cost centers and weights.
  destinations String
  /// Fixed percentage, headcount, floor area, revenue, labor hours, machine hours, or inventory quantity.
  basis String
  /// JSON basis parameters.
  parameters String
  /// Draft, active, or inactive.
  status String
  /// Effective start date.
  effective_from DateTime
  /// Optional effective end date.
  effective_to DateTime?
  /// Creation instant.
  created_at DateTime
  /// Last change instant.
  updated_at DateTime
}

/// One calculated execution of an allocation rule.
model allocation_executions {
  /// Primary key.
  id String @id
  /// Organization identifier.
  organization_id String
  /// Source rule identifier.
  rule_id String
  /// Allocated source amount.
  amount Float
  /// JSON input measures.
  input_measures String
  /// JSON calculated distributions.
  distributions String
  /// Calculated, approved, posted, or rejected.
  status String
  /// Resulting journal identifier.
  journal_id String?
  /// Operator identifier.
  operator_id String
  /// Creation instant.
  created_at DateTime
}

/// An immutable closing snapshot.
model closing_snapshots {
  /// Primary key.
  id String @id
  /// Organization identifier.
  organization_id String
  /// Fiscal period identifier.
  period_id String
  /// Close-cycle number for this immutable snapshot.
  close_cycle Int
  /// trial_balance, balance_sheet, profit_loss, inventory, or tax.
  kind String
  /// Dimension scope captured by this snapshot.
  dimensions String @default("{}")
  /// Serialized snapshot payload.
  payload String
  /// Creation instant.
  created_at DateTime
  @@unique([period_id, kind, close_cycle])
}

/// A workflow definition.
model workflows {
  /// Primary key.
  id String @id
  /// Organization identifier.
  organization_id String
  /// Target document kind.
  target_type String
  /// Priority.
  priority Int
  /// Draft, active, or inactive.
  status String
  /// Creation instant.
  created_at DateTime
  /// Last change instant.
  updated_at DateTime
  /// Amount, party, role, warehouse, currency, and risk conditions.
  conditions String @default("{}")
  /// Ordered approval steps.
  steps String @default("[]")
  /// Immutable configuration version.
  version Int @default(1)
  /// Previous workflow version, if any.
  base_workflow_id String?
}

/// A workflow approval request.
model approvals {
  /// Primary key.
  id String @id
  /// Organization identifier.
  organization_id String
  /// Target document kind.
  target_type String
  /// Target document identifier.
  target_id String
  /// Requester membership identifier.
  requester_membership_id String
  /// Explicit delegate currently assigned to this approval step.
  assigned_membership_id String?
  /// Workflow version selected when the request was created.
  workflow_id String?
  /// Immutable workflow version used by this request.
  workflow_version Int?
  /// Pending, approved, rejected, or changes.
  status String
  /// Current step number.
  current_step Int
  /// Creation instant.
  created_at DateTime
  /// Resolution instant.
  resolved_at DateTime?
  @@index([organization_id, target_type, target_id])
}

/// A source-document lock held while an approval request is active.
model approval_locks {
  /// Primary key.
  id String @id
  /// Organization identifier.
  organization_id String
  /// Target document kind.
  target_type String
  /// Target document identifier.
  target_id String
  /// Active approval holding the lock.
  approval_id String
  /// Whether the source remains locked.
  active Boolean
  /// Creation instant.
  created_at DateTime
  /// Release instant.
  released_at DateTime?
  @@unique([organization_id, target_type, target_id])
  @@index([organization_id, approval_id, active])
}

/// An immutable approval history row.
model approval_history {
  /// Primary key.
  id String @id
  /// Approval identifier.
  approval_id String
  /// Acting membership identifier.
  actor_membership_id String
  /// Action name.
  action String
  /// Workflow step at which the action occurred.
  step Int?
  /// Optional reason.
  reason String?
  /// Creation instant.
  created_at DateTime
}

/// An immutable audit event.
model audit_events {
  /// Primary key.
  id String @id
  /// Organization identifier.
  organization_id String
  /// Actor membership or system identifier.
  actor_id String
  /// Action name.
  action String
  /// Target type.
  target_type String
  /// Target identifier.
  target_id String
  /// Risk level.
  risk String
  /// Before value snapshot.
  before_value String?
  /// After value snapshot.
  after_value String?
  /// Reason.
  reason String?
  /// Request IP address.
  ip_address String?
  /// User agent.
  user_agent String?
  /// Creation instant.
  created_at DateTime
  @@index([organization_id, created_at])
}

/// A queued or delivered notification.
model notifications {
  /// Primary key.
  id String @id
  /// Organization identifier.
  organization_id String
  /// Recipient membership identifier.
  membership_id String
  /// Immutable originating audit or reminder identity.
  source_id String?
  /// Notification kind.
  kind String
  /// Delivery channel selected for this attempt.
  channel String @default("in_app")
  /// Message payload.
  payload String
  /// queued, sent, or failed.
  status String
  /// Retry count.
  attempts Int
  /// Creation instant.
  created_at DateTime
  /// Last dispatch attempt.
  sent_at DateTime?
  /// Last delivery failure detail.
  last_error String?
  @@unique([organization_id, membership_id, kind, source_id])
  @@index([organization_id, membership_id, status, created_at])
}

/// An employee timelog.
model timelogs {
  /// Primary key.
  id String @id
  /// Organization identifier.
  organization_id String
  /// Employee identifier.
  employee_id String
  /// Work date.
  work_date DateTime
  /// Hours.
  hours Float
  /// Optional project name.
  project String?
  /// Optional task identifier.
  task_id String?
  /// Optional description.
  description String?
  /// Whether the time is billable.
  billable Boolean
  /// Optional captured billing or payroll rate.
  rate Float?
  /// Whether the log is locked.
  locked Boolean
  /// Creation instant.
  created_at DateTime
}

/// A weekly timesheet.
model timesheets {
  /// Primary key.
  id String @id
  /// Organization identifier.
  organization_id String
  /// Employee identifier.
  employee_id String
  /// Week start date.
  week_start DateTime
  /// Draft, submitted, approved, or rejected.
  status String
  /// Rejection reason.
  rejection_reason String?
  /// Creation instant.
  created_at DateTime
  @@unique([organization_id, employee_id, week_start])
}

/// A payroll run.
model payroll_runs {
  /// Primary key.
  id String @id
  /// Organization identifier.
  organization_id String
  /// Pay period label.
  period String
  /// Optional pay schedule identifier.
  schedule_id String?
  /// Payment date.
  payment_date DateTime?
  /// Original run corrected by this run.
  correction_of_id String?
  /// Reversal or adjustment correction kind.
  correction_type String?
  /// Draft, calculated, approved, posted, or reversed.
  status String
  /// Total payroll cost.
  total Float
  /// Creation instant.
  created_at DateTime
  /// Posting instant.
  posted_at DateTime?
  /// Payment instant.
  paid_at DateTime?
}

/// An employee payslip.
model payslips {
  /// Primary key.
  id String @id
  /// Payroll run identifier.
  payroll_run_id String
  /// Employee identifier.
  employee_id String
  /// Gross pay.
  gross Float
  /// Tax and deductions.
  deductions Float
  /// Net pay.
  net Float
  /// Draft or published.
  status String
  /// Publication instant.
  published_at DateTime?
  /// Creation instant.
  created_at DateTime
}

/// A generic source-linked document attachment.
model attachments {
  /// Primary key.
  id String @id
  /// Organization identifier.
  organization_id String
  /// Target type.
  target_type String
  /// Target identifier.
  target_id String
  /// Original file name.
  file_name String
  /// MIME type.
  mime_type String
  /// Storage key.
  storage_key String
  /// Uploader membership identifier.
  uploader_id String
  /// Creation instant.
  created_at DateTime
}

/// A discussion comment on a concrete record.
model comments {
  /// Primary key.
  id String @id
  /// Organization identifier.
  organization_id String
  /// Target type.
  target_type String
  /// Target identifier.
  target_id String
  /// Author membership identifier.
  author_id String
  /// Comment body.
  body String
  /// Creation instant.
  created_at DateTime
  /// Last edit instant.
  updated_at DateTime
}

/// An organization tag.
model tags {
  /// Primary key.
  id String @id
  /// Organization identifier.
  organization_id String
  /// Label.
  label String
  /// Optional description.
  description String?
  /// Active lifecycle.
  active Boolean
  /// Creation instant.
  created_at DateTime
  @@unique([organization_id, label])
}

/// A tag assignment to a concrete record.
model tag_assignments {
  /// Primary key.
  id String @id
  /// Tag identifier.
  tag_id String
  /// Target type.
  target_type String
  /// Target identifier.
  target_id String
  /// Creation instant.
  created_at DateTime
  @@unique([tag_id, target_type, target_id])
}

/// Durable tenant-scoped scheduled work execution.
model automation_runs {
  /// Primary key.
  id String @id
  /// Organization that owns the run.
  organization_id String
  /// System membership that performed the work.
  system_membership_id String
  /// Stable scheduled job kind.
  job_type String
  /// Idempotency period or trigger key.
  period_key String
  /// queued, running, completed, or failed.
  status String
  /// Trigger description.
  trigger String
  /// Result payload.
  result String?
  /// Failure detail.
  error String?
  /// Start instant.
  started_at DateTime
  /// Completion instant.
  completed_at DateTime?
  /// Creation instant.
  created_at DateTime
  /// Retry count.
  attempts Int
  @@unique([organization_id, job_type, period_key])
  @@index([organization_id, status, created_at])
}

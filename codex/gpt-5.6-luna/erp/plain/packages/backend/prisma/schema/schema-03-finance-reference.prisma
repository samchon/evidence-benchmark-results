model currencies {
 id String @id
 organization_id String
 code String
 name String
 precision Int
 active Boolean
 created_at DateTime
 updated_at DateTime
 organization organizations @relation(fields:[organization_id],references:[id])
 source_rates exchange_rates[] @relation("source")
 target_rates exchange_rates[] @relation("target")
 @@unique([organization_id,code])
}
model exchange_rates {
 id String @id
 organization_id String
 source_currency_id String
 target_currency_id String
 effective_date DateTime
 rate Decimal
 origin String
 created_at DateTime
 organization organizations @relation(fields:[organization_id],references:[id])
 source_currency currencies @relation("source",fields:[source_currency_id],references:[id])
 target_currency currencies @relation("target",fields:[target_currency_id],references:[id])
 @@unique([organization_id,source_currency_id,target_currency_id,effective_date])
}
model payment_terms {
 id String @id
 organization_id String
 name String
 due_days Int
 due_day_of_month Int?
 active Boolean
 created_at DateTime
 updated_at DateTime
 organization organizations @relation(fields:[organization_id],references:[id])
 @@unique([organization_id,name])
}

model memberships {
 id String @id
 user_id String
 organization_id String
 status String
 created_at DateTime
 updated_at DateTime
 user users @relation(fields:[user_id], references:[id])
 organization organizations @relation(fields:[organization_id], references:[id])
 roles membership_roles[]
 @@unique([user_id,organization_id])
}
model sessions {
 id String @id
 user_id String
 organization_id String?
 token_hash String @unique
 expires_at DateTime
 revoked_at DateTime?
 created_at DateTime
 user users @relation(fields:[user_id],references:[id])
 organization organizations? @relation(fields:[organization_id],references:[id])
}
model recovery_proofs {
 id String @id
 user_id String
 token_hash String @unique
 expires_at DateTime
 used_at DateTime?
 created_at DateTime
 user users @relation(fields:[user_id],references:[id])
 @@index([user_id,expires_at])
}
model invitations {
 id String @id
 organization_id String
 inviter_user_id String
 accepted_user_id String?
 email String
 role_key String
 token_hash String @unique
 status String
 expires_at DateTime
 created_at DateTime
 accepted_at DateTime?
 organization organizations @relation(fields:[organization_id],references:[id])
 inviter users @relation("inviter",fields:[inviter_user_id],references:[id])
 accepted_user users? @relation("accepted_invitations",fields:[accepted_user_id],references:[id])
}
model roles {
 id String @id
 organization_id String
 key String
 name String
 built_in Boolean
 permissions String
 created_at DateTime
 organization organizations @relation(fields:[organization_id],references:[id])
 memberships membership_roles[]
 @@unique([organization_id,key])
}
model membership_roles {
 id String @id
 membership_id String
 role_id String
 created_at DateTime
 membership memberships @relation(fields:[membership_id],references:[id])
 role roles @relation(fields:[role_id],references:[id])
 @@unique([membership_id,role_id])
}
model system_principals {
 id String @id
 organization_id String @unique
 name String
 created_at DateTime
 organization organizations @relation(fields:[organization_id],references:[id])
}

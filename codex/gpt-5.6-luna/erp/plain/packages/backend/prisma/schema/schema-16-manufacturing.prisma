/// Versioned bill of materials for a manufactured item.
model boms {
  id String @id
  organization_id String
  item_id String
  version Int
  status String
  components_json String
  routing_json String
  created_at DateTime
  updated_at DateTime
  organization organizations @relation(fields:[organization_id], references:[id])
  @@unique([organization_id,item_id,version])
  @@index([organization_id,status,item_id])
}
/// Production order consuming a BOM and producing an item quantity.
model production_orders {
  id String @id
  organization_id String
  number String
  bom_id String
  item_id String
  warehouse_id String?
  planned_quantity Decimal
  completed_quantity Decimal
  status String
  scheduled_start DateTime?
  scheduled_end DateTime?
  created_at DateTime
  updated_at DateTime
  organization organizations @relation(fields:[organization_id], references:[id])
  @@unique([organization_id,number])
  @@index([organization_id,status,item_id])
}

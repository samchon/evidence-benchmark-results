/// Organization-scoped tax territory and filing context.
model tax_jurisdictions {
  /// UUID primary key.
  id String @id
  /// Owning organization.
  organization_id String
  /// Human-readable jurisdiction name.
  name String
  /// Territorial identity such as country or state code.
  territory_code String
  /// Whether new tax configuration may use this jurisdiction.
  active Boolean
  /// Creation instant.
  created_at DateTime
  /// Last descriptive update.
  updated_at DateTime
  /// Organization relation.
  organization organizations @relation(fields:[organization_id], references:[id])
  /// Tax codes under this jurisdiction.
  tax_codes tax_codes[]
  @@unique([organization_id,name])
  @@index([organization_id,territory_code,active])
}

/// Tax treatment code under one jurisdiction.
model tax_codes {
  /// UUID primary key.
  id String @id
  /// Owning organization.
  organization_id String
  /// Jurisdiction identity.
  jurisdiction_id String
  /// Closed code kind vocabulary.
  code_type String
  /// User-facing tax code name.
  name String
  /// Optional payable account relationship.
  payable_account_code String?
  /// Optional receivable account relationship.
  receivable_account_code String?
  /// Whether the code is selectable for new documents.
  active Boolean
  /// Creation instant.
  created_at DateTime
  /// Last update instant.
  updated_at DateTime
  /// Organization relation.
  organization organizations @relation(fields:[organization_id], references:[id])
  /// Jurisdiction relation.
  jurisdiction tax_jurisdictions @relation(fields:[jurisdiction_id], references:[id])
  /// Effective rates.
  rates tax_rates[]
  @@unique([organization_id,jurisdiction_id,name])
  @@index([organization_id,active])
}

/// Effective percentage for one tax code and date window.
model tax_rates {
  /// UUID primary key.
  id String @id
  /// Tax code identity.
  tax_code_id String
  /// Inclusive start date.
  effective_from DateTime
  /// Exclusive end date; null means open-ended.
  effective_to DateTime?
  /// Rate as decimal fraction.
  rate Decimal
  /// Creation instant.
  created_at DateTime
  /// Tax code relation.
  tax_code tax_codes @relation(fields:[tax_code_id], references:[id])
  @@index([tax_code_id,effective_from])
}

/// Quantity unit used by items and operational documents.
model units_of_measure {
  /// UUID primary key.
  id String @id
  /// Owning organization.
  organization_id String
  /// Stable unit code.
  code String
  /// Unit display name.
  name String
  /// Unit category such as quantity, weight, or time.
  category String
  /// Whether new documents may select the unit.
  active Boolean
  /// Creation instant.
  created_at DateTime
  /// Last update instant.
  updated_at DateTime
  /// Organization relation.
  organization organizations @relation(fields:[organization_id], references:[id])
  @@unique([organization_id,code])
  @@index([organization_id,active])
}

/// Per-document-type human numbering sequence.
model document_number_sequences {
  /// UUID primary key.
  id String @id
  /// Owning organization.
  organization_id String
  /// Operational document type.
  document_type String
  /// Prefix convention.
  prefix String
  /// Next number to issue.
  next_value Int
  /// Minimum width for zero padding.
  width Int
  /// Whether the sequence is active.
  active Boolean
  /// Last update instant.
  updated_at DateTime
  /// Organization relation.
  organization organizations @relation(fields:[organization_id], references:[id])
  @@unique([organization_id,document_type])
}

/// Fiscal year partitioning one organization's dates.
model fiscal_years {
  /// UUID primary key.
  id String @id
  /// Owning organization.
  organization_id String
  /// Fiscal year label.
  year Int
  /// Inclusive start date.
  starts_on DateTime
  /// Exclusive end date.
  ends_on DateTime
  /// Lifecycle state: open, closed, or reopened.
  status String
  /// Creation instant.
  created_at DateTime
  /// Organization relation.
  organization organizations @relation(fields:[organization_id], references:[id])
  /// Periods in the year.
  periods fiscal_periods[]
  @@unique([organization_id,year])
  @@index([organization_id,starts_on,ends_on])
}

/// One named fiscal period.
model fiscal_periods {
  /// UUID primary key.
  id String @id
  /// Fiscal year identity.
  fiscal_year_id String
  /// One-based period number.
  number Int
  /// Inclusive start date.
  starts_on DateTime
  /// Exclusive end date.
  ends_on DateTime
  /// Lifecycle state: open, soft_closed, hard_closed, or reopened.
  status String
  /// Creation instant.
  created_at DateTime
  /// Fiscal year relation.
  fiscal_year fiscal_years @relation(fields:[fiscal_year_id], references:[id])
  @@unique([fiscal_year_id,number])
}
